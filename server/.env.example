# Copy of the settings the server understands. Your real values live in
# server/.env on your computer (never commit that file) and in the
# "Environment" page of the service on Render.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/layerforge
JWT_SECRET=at-least-32-random-characters-generated-for-you-on-first-run

# Razorpay - https://dashboard.razorpay.com/app/keys
# Use TEST keys (rzp_test_...) until you are ready to take real money.
# Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
